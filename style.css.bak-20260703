/*
Theme Name:   myathletik Child
Theme URI:    https://myathletik.com
Description:   Custom child theme for the myathletik.com rebuild. Built on GeneratePress. Code-first: layout, structure and styling are controlled here, not via a page builder.
Author:       myathletik
Template:     generatepress
Version:      0.1.0
Text Domain:  myathletik-child
*/

/* =========================================================
   Design tokens â€?defined once, reused everywhere.
   Edit these to retheme the whole site.
   ========================================================= */
:root {
  /* Colors â€?warm palette (see docs/design-brief.md). Tune, don't replace. */
  --ma-color-bg:        #faf8f5; /* warm off-white / cream background */
  --ma-color-surface:   #f1ede7; /* warm light surface for cards/sections */
  --ma-color-text:      #2b2724; /* warm near-black, not pure #000 */
  --ma-color-muted:     #6f675f; /* warm gray for secondary text */
  --ma-color-accent:    #c4602f; /* terracotta / burnt orange â€?CTAs, highlights */
  --ma-color-accent-2:  #9a4a23; /* darker terracotta for hovers/links */
  --ma-color-border:    #e2dad0; /* warm border */
  --ma-color-white:     #ffffff; /* pure white for surfaces */
  --ma-color-dark:      #0c0b0a; /* dark for footer/CTA bands */

  /* Typography */
  --ma-font-body:    system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --ma-font-head:    "Manrope", var(--ma-font-body);
  --ma-fs-base:      1rem;
  --ma-fs-h1:        clamp(2rem, 4vw, 3rem);
  --ma-fs-h2:        clamp(1.5rem, 3vw, 2.25rem);
  --ma-fs-h3:        1.25rem;
  --ma-lh-body:      1.6;

  /* Spacing scale */
  --ma-space-1: 0.25rem;
  --ma-space-2: 0.5rem;
  --ma-space-3: 1rem;
  --ma-space-4: 1.5rem;
  --ma-space-5: 2.5rem;
  --ma-space-6: 4rem;

  /* Layout */
  --ma-container:    1200px;
  --ma-radius:       6px;
}

html,
body {
  overflow-x: hidden;
}

/* =========================================================
   Custom styles below. Keep organized and commented.
   Agents: add clear section comments for each block.
   ========================================================= */

/* --- Site Header / Navigation --- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--ma-color-white);
  border-bottom: 1px solid rgba(226, 218, 208, 0.9);
  box-shadow: 0 8px 24px rgba(43, 39, 36, 0.06);
}

.inside-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
  width: 100%;
  max-width: var(--ma-container);
  margin: 0 auto;
  padding: 0.85rem var(--ma-space-4);
  gap: var(--ma-space-3);
  box-sizing: border-box;
}

.site-branding-container,
.site-branding {
  min-width: 0;
}

.site-branding-container {
  flex: 0 0 auto;
  max-width: 20rem;
}

.site-logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.site-logo img,
.site-header .header-image {
  display: block;
  width: auto;
  max-width: 8.5rem;
  height: 3.25rem;
  object-fit: contain;
}

.site-branding .main-title {
  margin: 0;
  font-family: var(--ma-font-head);
  font-size: clamp(1.85rem, 2.2vw, 2.35rem);
  font-weight: 600;
  letter-spacing: -0.012em;
  line-height: 1;
  white-space: nowrap;
}

.site-branding .main-title a {
  color: var(--ma-color-text);
}

.site-description {
  margin-top: 0.15rem;
  color: var(--ma-color-muted);
  font-size: 0.8rem;
  line-height: 1.3;
}

.main-navigation {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 1 1 0;
  min-width: 0;
  background: transparent;
}

.nav-float-right #site-navigation {
  margin-left: auto;
}

.main-navigation .inside-navigation {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  gap: var(--ma-space-2);
  width: 100%;
  padding: 0;
}

.main-navigation .main-nav ul {
  gap: 0.05rem;
}

.main-navigation:not(.toggled) .main-nav {
  flex: 0 1 auto;
  min-width: 0;
}

.main-navigation:not(.toggled) .main-nav > ul {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  margin: 0;
}

.main-navigation:not(.toggled) .main-nav > ul > li {
  flex: 0 0 auto;
  float: none;
}

.main-navigation .main-nav ul li a,
.main-navigation .menu-toggle,
.main-navigation .menu-bar-item > a {
  border-radius: 999px;
  color: var(--ma-color-text);
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 2.8rem;
  padding-right: 0.72rem;
  padding-left: 0.72rem;
  white-space: nowrap;
}

.main-navigation .main-nav ul li.menu-item-has-children > a {
  padding-right: 0;
}

.main-navigation .menu-item-has-children .dropdown-menu-toggle {
  padding-right: 0.72rem;
  padding-left: 0.25rem;
}

.main-navigation .main-nav ul li:not([class*="current-menu-"]):hover > a,
.main-navigation .main-nav ul li:not([class*="current-menu-"]):focus > a,
.main-navigation .main-nav ul li.sfHover:not([class*="current-menu-"]) > a,
.main-navigation .menu-bar-item:hover > a,
.main-navigation .menu-bar-item:focus > a,
.main-navigation .main-nav ul li[class*="current-menu-"] > a {
  background: var(--ma-color-surface);
  color: var(--ma-color-accent-2);
}

.main-navigation:not(.toggled) .main-nav > ul > li:last-child > a {
  margin-left: 0.2rem;
  background: var(--ma-color-accent);
  color: var(--ma-color-bg);
  box-shadow: 0 10px 22px rgba(196, 96, 47, 0.22);
}

.main-navigation:not(.toggled) .main-nav > ul > li:last-child:hover > a,
.main-navigation:not(.toggled) .main-nav > ul > li:last-child:focus > a {
  background: var(--ma-color-accent-2);
  color: var(--ma-color-bg);
}

.main-navigation ul ul {
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-bg);
  box-shadow: 0 18px 34px rgba(43, 39, 36, 0.12);
  overflow: hidden;
  width: 17rem;
}

.main-navigation .main-nav ul ul li a {
  border-radius: 0;
  color: var(--ma-color-text);
  font-size: 0.95rem;
  font-weight: 650;
  line-height: 1.4;
  padding: 0.85rem 1rem;
}

.main-navigation .main-nav ul ul li:not([class*="current-menu-"]):hover > a,
.main-navigation .main-nav ul ul li:not([class*="current-menu-"]):focus > a,
.main-navigation .main-nav ul ul li[class*="current-menu-"] > a {
  background: var(--ma-color-surface);
  color: var(--ma-color-accent-2);
}

.ma-header-actions {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 0;
  margin-left: var(--ma-space-2);
}

.ma-language-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  min-height: 2.35rem;
  padding: 0 0.72rem;
  border: 1px solid var(--ma-color-border);
  background: var(--ma-color-bg);
  border-radius: 999px;
  color: var(--ma-color-text);
  font-size: 0.88rem;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
}

.ma-language-toggle:hover,
.ma-language-toggle:focus {
  border-color: var(--ma-color-accent);
  color: var(--ma-color-accent-2);
}

.ma-language-menu {
  position: relative;
}

.ma-language-options {
  position: absolute;
  top: calc(100% + 0.45rem);
  right: 0;
  z-index: 80;
  display: grid;
  min-width: 5.4rem;
  margin: 0;
  padding: var(--ma-space-2) 0;
  list-style: none;
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-text);
  box-shadow: 0 18px 34px rgba(43, 39, 36, 0.18);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-0.3rem);
  transition: opacity 140ms ease, transform 140ms ease;
}

.ma-language-menu:hover .ma-language-options,
.ma-language-menu:focus-within .ma-language-options {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.ma-language-options button {
  width: 100%;
  padding: 0.58rem 1rem;
  border: 0;
  background: transparent;
  color: var(--ma-color-bg);
  font-size: 0.95rem;
  font-weight: 800;
  text-align: left;
  cursor: pointer;
}

.ma-language-options button:hover,
.ma-language-options button:focus {
  background: rgba(250, 248, 245, 0.12);
  color: var(--ma-color-accent);
}

@media (min-width: 48.01rem) and (max-width: 74rem) {
  .inside-header {
    gap: var(--ma-space-2);
  }

  .site-branding .main-title {
    font-size: 1.7rem;
  }

  .main-navigation .main-nav ul li a,
  .main-navigation .menu-toggle,
  .main-navigation .menu-bar-item > a {
    font-size: 0.9rem;
    padding-right: 0.58rem;
    padding-left: 0.58rem;
  }

  .main-navigation .menu-item-has-children .dropdown-menu-toggle {
    padding-right: 0.58rem;
    padding-left: 0.18rem;
  }

  .site-logo img,
  .site-header .header-image {
    max-width: 7.5rem;
    height: 2.9rem;
  }
}

@media (max-width: 48rem) {
  .site-header {
    position: relative;
  }

  .inside-header {
    flex-wrap: wrap;
    gap: var(--ma-space-3);
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
  }

  .site-logo img,
  .site-header .header-image {
    max-width: 8.5rem;
    height: 2.95rem;
  }

  .site-branding .main-title {
    font-size: 1.45rem;
  }

  .main-navigation .main-nav ul li a,
  .main-navigation .menu-toggle,
  .main-navigation .menu-bar-item > a {
    border-radius: var(--ma-radius);
    line-height: 2.7rem;
  }

  .main-navigation {
    flex: 1 1 100%;
    width: 100%;
  }

  .main-navigation .inside-navigation {
    justify-content: stretch;
  }

  .main-navigation .menu-toggle {
    margin-left: auto;
    background: var(--ma-color-surface);
    color: var(--ma-color-text);
  }

  .main-navigation.toggled .main-nav {
    width: 100%;
    margin-top: var(--ma-space-3);
  }

  .main-navigation.toggled .main-nav > ul {
    display: grid;
    gap: var(--ma-space-2);
    width: 100%;
    margin: 0;
    padding: var(--ma-space-3);
    border: 1px solid var(--ma-color-border);
    border-radius: var(--ma-radius);
    background: var(--ma-color-bg);
    box-shadow: 0 14px 28px rgba(43, 39, 36, 0.1);
  }

  .main-navigation.toggled .main-nav li {
    float: none;
    width: 100%;
    text-align: left;
  }

  .main-navigation.toggled .main-nav ul li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: var(--ma-space-3);
    padding-left: var(--ma-space-3);
  }

  .main-navigation.toggled ul ul {
    width: 100%;
    margin-top: var(--ma-space-2);
    margin-left: 0;
    border: 0;
    border-left: 2px solid var(--ma-color-accent);
    border-radius: 0;
    background: var(--ma-color-surface);
    box-shadow: none;
  }

  .main-navigation.toggled .main-nav ul ul li a {
    padding-left: var(--ma-space-4);
  }

  .ma-header-actions {
    flex: 0 0 auto;
    margin: 0 0 0 auto;
  }

  .main-navigation:not(.toggled) .main-nav > ul > li:last-child > a {
    margin-left: 0;
  }
}

/* --- Home: Hero --- */
.ma-home {
  width: 100%;
  margin: 0;
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
  font-family: var(--ma-font-body);
}

body.home .site-main.ma-home {
  margin: 0;
  max-width: none;
}

body.home .site-content,
body.home .content-area,
body.home .inside-article {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;
}

body.home .site-content.grid-container {
  max-width: none;
}

body.home .container.grid-container {
  width: 100%;
  max-width: none;
  padding-right: 0;
  padding-left: 0;
}

.ma-home > section {
  width: 100%;
}

.ma-home-hero {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 58vh;
  overflow: hidden;
  isolation: isolate;
}

.ma-home-hero__media,
.ma-home-hero__overlay {
  position: absolute;
  inset: 0;
}

.ma-home-hero__media {
  z-index: -2;
  background-position: 54% center;
  background-repeat: no-repeat;
  background-size: cover;
}

.ma-home-hero__overlay {
  z-index: -1;
  background: linear-gradient(180deg, rgba(43, 39, 36, 0.78), rgba(43, 39, 36, 0.58));
}

.ma-home-hero__inner {
  width: 100%;
  max-width: var(--ma-container);
  margin: 0 auto;
  padding: var(--ma-space-4) var(--ma-space-4);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ma-home-hero__content {
  max-width: 42rem;
  color: var(--ma-color-bg);
  text-align: center;
}

.ma-home-hero__eyebrow {
  margin: 0 0 var(--ma-space-3);
  color: rgba(250, 248, 245, 0.84);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.4;
  text-transform: uppercase;
}

.ma-home-hero__title {
  margin: 0;
  color: var(--ma-color-bg);
  font-family: var(--ma-font-head);
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.1;
  text-shadow: 0 0.18rem 1.1rem rgba(0, 0, 0, 0.38);
}

.ma-home-hero__subhead {
  max-width: 36rem;
  margin: var(--ma-space-4) 0 0;
  color: rgba(250, 248, 245, 0.9);
  font-size: 1.05rem;
  line-height: 1.55;
}

.ma-home-hero__actions {
  display: flex;
  flex-direction: column;
  flex-wrap: wrap;
  align-items: stretch;
  justify-content: center;
  gap: var(--ma-space-3);
  margin-top: var(--ma-space-4);
}

.ma-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 3rem;
  padding: 0.78rem 1.15rem;
  border: 1px solid transparent;
  border-radius: var(--ma-radius);
  font-weight: 700;
  line-height: 1.2;
  text-decoration: none;
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
}

.ma-button:focus-visible {
  outline: 3px solid rgba(250, 248, 245, 0.7);
  outline-offset: 3px;
}

.ma-button--primary {
  background: var(--ma-color-accent);
  color: var(--ma-color-bg);
}

.ma-button--primary:hover,
.ma-button--primary:focus {
  background: var(--ma-color-accent-2);
  color: var(--ma-color-bg);
}

.ma-button--secondary {
  border-color: rgba(250, 248, 245, 0.58);
  color: var(--ma-color-bg);
}

.ma-button--secondary:hover,
.ma-button--secondary:focus {
  background: rgba(250, 248, 245, 0.12);
  border-color: rgba(250, 248, 245, 0.86);
  color: var(--ma-color-bg);
}

@media (min-width: 42rem) {
  .ma-home-hero {
    min-height: 64vh;
  }

  .ma-home-hero__media {
    background-position: 58% center;
  }

  .ma-home-hero__overlay {
    background:
      linear-gradient(180deg, rgba(43, 39, 36, 0.72), rgba(43, 39, 36, 0.54)),
      linear-gradient(90deg, rgba(43, 39, 36, 0.72), rgba(43, 39, 36, 0.18));
  }

  .ma-home-hero__inner {
    padding: var(--ma-space-5) var(--ma-space-4);
  }

  .ma-home-hero__title {
    font-size: 3rem;
  }

  .ma-home-hero__subhead {
    font-size: 1.2rem;
  }

  .ma-home-hero__actions {
    flex-direction: row;
    align-items: center;
  }
}

/* --- Home: Client Logos --- */
.ma-client-logos {
  position: relative;
  overflow: hidden;
  width: 100%;
  margin: 0;
  background: var(--ma-color-white);
  color: var(--ma-color-muted);
  border-top: 1px solid var(--ma-color-border);
  border-bottom: 1px solid var(--ma-color-border);
  box-shadow: 0 0 0 100vmax var(--ma-color-white);
  clip-path: inset(0 -100vmax);
}

.ma-client-logos__inner {
  width: 100%;
  max-width: none;
  margin: 0 auto;
  padding: 1.6rem 0 1.9rem;
  box-sizing: border-box;
}

.ma-client-logos__heading {
  max-width: var(--ma-container);
  margin: 0 auto 1.25rem;
  padding: 0 var(--ma-space-4);
  color: var(--ma-color-muted);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  line-height: 1.4;
  text-align: center;
  text-transform: uppercase;
}

.ma-client-logos__viewport {
  width: 100%;
  overflow: hidden;
}

.ma-client-logos__track {
  display: flex;
  align-items: center;
  gap: clamp(2.4rem, 4vw, 5rem);
  width: max-content;
  padding: 0;
  will-change: transform;
  animation: ma-client-logo-scroll 120s linear infinite;
}

.ma-client-logos__viewport:hover .ma-client-logos__track,
.ma-client-logos__viewport:focus-within .ma-client-logos__track {
  animation-play-state: paused;
}

.ma-client-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  height: 5.25rem;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
}

.ma-client-logo img {
  display: block;
  width: auto;
  max-width: 15rem;
  height: 4.5rem;
  max-height: 4.5rem;
  object-fit: contain;
  filter: none;
  opacity: 1;
  transition: filter 180ms ease, opacity 180ms ease, transform 180ms ease;
}

.ma-client-logo:hover img,
.ma-client-logo:focus-within img {
  filter: none;
  opacity: 1;
  transform: translateY(-1px);
}

@keyframes ma-client-logo-scroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

@media (max-width: 48rem) {
  .ma-client-logos__inner {
    padding: 1.3rem 0 1.45rem;
  }

  .ma-client-logos__heading {
    margin-bottom: 1rem;
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    line-height: 1.45;
  }

  .ma-client-logos__track {
    gap: 2rem;
    animation-duration: 105s;
  }

  .ma-client-logo {
    height: 4.25rem;
  }

  .ma-client-logo img {
    max-width: 11.5rem;
    height: 3.5rem;
    max-height: 3.5rem;
  }
}

/* --- Home: Style Gallery --- */
.ma-home-style-gallery {
  overflow: hidden;
  background:
    linear-gradient(180deg, var(--ma-color-bg) 0%, rgba(250, 248, 245, 0.92) 55%, var(--ma-color-surface) 100%);
}

.ma-home-style-gallery .ma-section-inner {
  padding-bottom: var(--ma-space-4);
}

.ma-style-marquee {
  width: 100%;
  padding: 0 0 var(--ma-space-6);
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
}

.ma-style-marquee__track {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  width: max-content;
  padding: 0 1rem;
  will-change: transform;
  animation: ma-style-scroll 35s linear infinite;
}

.ma-style-marquee:focus-within .ma-style-marquee__track {
  animation-play-state: paused;
}

.ma-style-card {
  margin: 0;
  overflow: hidden;
  border-radius: var(--ma-radius);
  background: var(--ma-color-border);
  box-shadow: 0 18px 38px rgba(43, 39, 36, 0.14);
}

.ma-style-column {
  display: grid;
  grid-auto-rows: min-content;
  gap: 1rem;
  width: clamp(10.5rem, 16vw, 15.5rem);
}

.ma-style-card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  transition: transform 220ms ease;
}

.ma-style-card:hover img {
  transform: scale(1.035);
}

.ma-style-card--short {
  aspect-ratio: 1 / 0.95;
}

.ma-style-card--medium {
  aspect-ratio: 2 / 2.35;
}

.ma-style-card--tall {
  aspect-ratio: 2 / 3.15;
}

@keyframes ma-style-scroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-33.3333%);
  }
}

@media (max-width: 48rem) {
  .ma-style-marquee {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .ma-style-marquee__track {
    gap: 0.85rem;
    padding: 0 var(--ma-space-3);
    animation-duration: 28s;
  }

  .ma-style-column {
    width: 11.5rem;
    scroll-snap-align: center;
  }
}

/* --- Home: Shared Sections --- */
.ma-section-inner {
  width: 100%;
  max-width: var(--ma-container);
  margin: 0 auto;
  padding: var(--ma-space-6) var(--ma-space-4);
  box-sizing: border-box;
}

.ma-section-heading {
  max-width: 42rem;
  margin-bottom: var(--ma-space-5);
}

.ma-section-heading--center {
  margin-right: auto;
  margin-left: auto;
  text-align: center;
}

.ma-section-heading h2 {
  margin: 0;
  color: var(--ma-color-text);
  font-family: var(--ma-font-head);
  font-size: var(--ma-fs-h2);
  line-height: 1.15;
}

.ma-section-heading p:not(.ma-section-kicker) {
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  font-size: 1rem;
  line-height: var(--ma-lh-body);
}

.ma-section-kicker {
  margin: 0 0 var(--ma-space-2);
  color: var(--ma-color-accent-2);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.4;
  text-transform: uppercase;
}

.ma-text-link {
  color: var(--ma-color-accent-2);
  font-weight: 700;
  text-decoration-thickness: 2px;
  text-underline-offset: 0.25em;
}

/* --- Home: Capability Proof --- */
.ma-home-proof {
  background: var(--ma-color-bg);
}

.ma-home-proof__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-home-proof__item {
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: rgba(255, 255, 255, 0.42);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
}

.ma-home-proof__mark {
  display: block;
  width: 2rem;
  height: 0.22rem;
  margin-bottom: var(--ma-space-3);
  border-radius: 999px;
  background: var(--ma-color-accent);
}

.ma-home-proof__item h3,
.ma-home-proof__item p {
  margin: 0;
}

.ma-home-proof__item h3 {
  color: var(--ma-color-text);
  font-size: var(--ma-fs-h3);
}

.ma-home-proof__item p {
  margin-top: var(--ma-space-2);
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

@media (min-width: 48rem) {
  .ma-home-proof__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

/* --- Home: Product Categories --- */
.ma-home-categories {
  background:
    linear-gradient(180deg, var(--ma-color-bg) 0%, var(--ma-color-surface) 100%);
}

.ma-home-categories__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-category-card {
  position: relative;
  display: block;
  aspect-ratio: 4 / 3;
  min-height: 0;
  overflow: hidden;
  border-radius: var(--ma-radius);
  background: var(--ma-color-text);
  color: var(--ma-color-bg);
  box-shadow: 0 16px 34px rgba(43, 39, 36, 0.12);
  text-decoration: none;
  transform: translateY(0);
  transition: box-shadow 180ms ease, transform 180ms ease;
}

.ma-category-card::after {
  position: absolute;
  inset: 34% 0 0;
  content: "";
  background: linear-gradient(180deg, rgba(43, 39, 36, 0), rgba(43, 39, 36, 0.74));
  pointer-events: none;
}

.ma-category-card img {
  display: block;
  width: 100%;
  height: 100%;
  max-height: none;
  min-height: 0;
  object-fit: cover;
  opacity: 0.92;
  transition: opacity 180ms ease, transform 180ms ease;
}

.ma-category-card span {
  position: absolute;
  z-index: 1;
  left: var(--ma-space-3);
  right: var(--ma-space-3);
  bottom: var(--ma-space-3);
  font-size: 1.2rem;
  font-weight: 700;
  line-height: 1.2;
}

.ma-category-card:hover img,
.ma-category-card:focus img {
  opacity: 1;
  transform: scale(1.03);
}

.ma-category-card:hover,
.ma-category-card:focus {
  box-shadow: 0 22px 44px rgba(43, 39, 36, 0.18);
  transform: translateY(-2px);
}

@media (min-width: 48rem) {
  .ma-home-categories__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ma-category-card {
    aspect-ratio: 4 / 3;
  }

  .ma-category-card span {
    left: var(--ma-space-4);
    right: var(--ma-space-4);
    bottom: var(--ma-space-4);
    font-size: 1.35rem;
  }
}

@media (min-width: 70rem) {
  .ma-home-categories__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .ma-category-card {
    aspect-ratio: 4 / 3;
  }
}

/* --- Home: Why Myathletik --- */
.ma-home-why {
  background: var(--ma-color-bg);
}

.ma-home-why__layout {
  display: grid;
  gap: var(--ma-space-5);
}

.ma-home-why__list {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-reason-card {
  padding: var(--ma-space-4);
  border-left: 3px solid var(--ma-color-accent);
  background: var(--ma-color-surface);
  border-radius: var(--ma-radius);
  box-shadow: 0 12px 26px rgba(43, 39, 36, 0.07);
}

.ma-reason-card span {
  color: var(--ma-color-accent-2);
  font-weight: 800;
}

.ma-reason-card h3 {
  margin: var(--ma-space-2) 0 0;
  font-size: var(--ma-fs-h3);
}

.ma-reason-card p {
  margin: var(--ma-space-2) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

@media (min-width: 48rem) {
  .ma-home-why__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* --- Home: Numbers Proof --- */
.ma-home-numbers {
  background: var(--ma-color-text);
  color: var(--ma-color-bg);
}

.ma-home-numbers .ma-section-heading h2,
.ma-home-numbers .ma-section-kicker {
  color: var(--ma-color-bg);
}

.ma-home-numbers__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-number-card {
  display: flex;
  min-height: 100%;
  flex-direction: column;
  padding: var(--ma-space-4);
  border: 1px solid rgba(250, 248, 245, 0.18);
  border-radius: var(--ma-radius);
  background: rgba(250, 248, 245, 0.06);
  box-shadow: inset 0 1px 0 rgba(250, 248, 245, 0.08);
}

.ma-number-card__figure {
  display: grid;
  min-height: 4.85rem;
  align-content: start;
  gap: 0.45rem;
}

.ma-number-card__figure strong {
  display: inline-block;
  color: var(--ma-color-bg);
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  line-height: 1;
  white-space: nowrap;
}

.ma-number-card__figure span {
  display: block;
  color: rgba(250, 248, 245, 0.74);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  line-height: 1.2;
  text-transform: uppercase;
}

.ma-number-card h3 {
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-bg);
  font-size: var(--ma-fs-h3);
}

.ma-number-card p {
  margin: var(--ma-space-2) 0 0;
  color: rgba(250, 248, 245, 0.76);
  line-height: var(--ma-lh-body);
}

@media (min-width: 48rem) {
  .ma-home-numbers__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 30rem) {
  .ma-number-card__figure {
    min-height: auto;
  }
}

/* --- Home: Process Snapshot --- */
.ma-home-process {
  background: var(--ma-color-bg);
}

.ma-home-process__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-process-step {
  display: block;
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: rgba(255, 255, 255, 0.44);
  color: var(--ma-color-text);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
  text-decoration: none;
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}

.ma-process-step--featured {
  border-color: var(--ma-color-accent);
  background: var(--ma-color-surface);
}

.ma-process-step:hover,
.ma-process-step:focus {
  border-color: var(--ma-color-accent);
  box-shadow: 0 16px 30px rgba(43, 39, 36, 0.12);
  transform: translateY(-2px);
}

.ma-process-step span {
  color: var(--ma-color-accent-2);
  font-weight: 800;
}

.ma-process-step h3 {
  margin: var(--ma-space-3) 0 0;
  font-size: var(--ma-fs-h3);
}

.ma-process-step p {
  margin: var(--ma-space-2) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

@media (min-width: 48rem) {
  .ma-home-process__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

/* --- Home: Partnership Trust --- */
.ma-home-partnership {
  background: var(--ma-color-surface);
}

.ma-home-partnership__layout {
  display: grid;
  gap: var(--ma-space-5);
}

.ma-home-partnership__image {
  aspect-ratio: 4 / 3;
  max-height: 420px;
  overflow: hidden;
  border-radius: var(--ma-radius);
  background: var(--ma-color-border);
  box-shadow: 0 18px 40px rgba(43, 39, 36, 0.14);
}

.ma-home-partnership__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ma-home-partnership__content {
  max-width: 34rem;
}

.ma-home-partnership__content h2 {
  margin: 0;
  font-size: var(--ma-fs-h2);
  line-height: 1.15;
}

.ma-home-partnership__content p:not(.ma-section-kicker) {
  margin: var(--ma-space-3) 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

@media (min-width: 48rem) {
  .ma-home-partnership__layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: center;
  }
}

/* --- Home: Certifications --- */
.ma-home-certifications {
  background: var(--ma-color-bg);
}

.ma-certification-groups {
  display: grid;
  gap: var(--ma-space-5);
}

.ma-certification-group {
  display: grid;
  gap: var(--ma-space-3);
}

.ma-certification-group h3 {
  margin: 0;
  font-size: var(--ma-fs-h3);
}

.ma-certification-group p {
  max-width: 48rem;
  margin: 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

.ma-home-certifications__strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--ma-space-4);
}

.ma-certification-badge {
  display: grid;
  min-height: 7rem;
  place-items: center;
  padding: var(--ma-space-3);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: rgba(255, 255, 255, 0.5);
}

.ma-certification-badge img {
  max-width: 5.5rem;
  max-height: 5.5rem;
  object-fit: contain;
}

@media (min-width: 48rem) {
  .ma-home-certifications__strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (min-width: 64rem) {
  .ma-home-certifications__strip {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
}

/* --- Home: Latest Posts --- */
.ma-home-latest {
  background: var(--ma-color-surface);
}

.ma-home-latest__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-post-card a {
  display: block;
  height: 100%;
  padding: var(--ma-space-4);
  border-radius: var(--ma-radius);
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
  text-decoration: none;
}

.ma-post-card time {
  color: var(--ma-color-muted);
  font-size: 0.9rem;
}

.ma-post-card h3 {
  margin: var(--ma-space-2) 0 0;
  font-size: var(--ma-fs-h3);
}

.ma-post-card p,
.ma-home-latest__empty {
  margin: var(--ma-space-2) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

@media (min-width: 48rem) {
  .ma-home-latest__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* --- Home: Inquiry CTA --- */
.ma-home-inquiry {
  background: var(--ma-color-text);
  color: var(--ma-color-bg);
}

.ma-home-inquiry__layout {
  display: grid;
  gap: var(--ma-space-5);
}

.ma-home-inquiry .ma-section-kicker,
.ma-home-inquiry h2 {
  color: var(--ma-color-bg);
}

.ma-home-inquiry h2 {
  margin: 0;
  font-size: var(--ma-fs-h2);
  line-height: 1.15;
}

.ma-home-inquiry__copy p:not(.ma-section-kicker) {
  color: rgba(250, 248, 245, 0.78);
  line-height: var(--ma-lh-body);
}

.ma-inquiry-form {
  display: grid;
  gap: var(--ma-space-4);
  padding: var(--ma-space-4);
  border-radius: var(--ma-radius);
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
}

.ma-form-row {
  display: grid;
  gap: var(--ma-space-2);
}

.ma-form-row label {
  font-weight: 700;
}

.ma-form-row input,
.ma-form-row select,
.ma-form-row textarea {
  width: 100%;
  min-height: 2.9rem;
  padding: 0.7rem 0.8rem;
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-white);
  color: var(--ma-color-text);
  font: inherit;
}

.ma-form-row textarea {
  min-height: 8rem;
  resize: vertical;
}

.ma-inquiry-form__note {
  margin: 0;
  color: var(--ma-color-muted);
  font-size: 0.9rem;
  line-height: 1.5;
}

@media (min-width: 48rem) {
  .ma-inquiry-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ma-form-row--full,
  .ma-inquiry-form .ma-button,
  .ma-inquiry-form__note {
    grid-column: 1 / -1;
  }
}

/* --- Fluent Forms styling --- */
.ma-inquiry-form--fluent {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.ma-inquiry-form--fluent > *,
.ma-contact-form-panel .fluentform,
.ma-contact-form-panel .frm-fluent-form,
.ma-contact-form-panel form,
.ma-inquiry-form--fluent .fluentform,
.ma-inquiry-form--fluent .frm-fluent-form,
.ma-inquiry-form--fluent form {
  width: 100%;
  max-width: none;
  box-sizing: border-box;
}

.ma-contact-form-panel .fluentform,
.ma-contact-form-panel .frm-fluent-form,
.ma-inquiry-form--fluent .fluentform,
.ma-inquiry-form--fluent .frm-fluent-form {
  margin-top: var(--ma-space-4);
}

.ma-contact-form-panel .ff-el-group,
.ma-inquiry-form--fluent .ff-el-group {
  width: 100%;
  margin-bottom: var(--ma-space-3);
  box-sizing: border-box;
}

.ma-contact-form-panel .ff-t-container,
.ma-inquiry-form--fluent .ff-t-container {
  display: grid;
  width: 100%;
  gap: var(--ma-space-3);
  margin: 0;
  box-sizing: border-box;
}

.ma-contact-form-panel .ff-t-cell,
.ma-inquiry-form--fluent .ff-t-cell {
  width: 100% !important;
  max-width: none !important;
  min-width: 0;
  padding: 0 !important;
  box-sizing: border-box;
}

.ma-contact-form-panel .ff-el-input--label,
.ma-inquiry-form--fluent .ff-el-input--label {
  display: grid;
  align-items: end;
  margin-bottom: var(--ma-space-2);
}

.ma-contact-form-panel .ff-el-input--label label,
.ma-inquiry-form--fluent .ff-el-input--label label {
  margin: 0;
  color: var(--ma-color-text);
  font-size: 0.95rem;
  font-weight: 700;
  line-height: 1.3;
}

.ma-contact-form-panel .ff-el-form-control,
.ma-contact-form-panel input[type="text"],
.ma-contact-form-panel input[type="email"],
.ma-contact-form-panel input[type="url"],
.ma-contact-form-panel input[type="tel"],
.ma-contact-form-panel input[type="number"],
.ma-contact-form-panel input[type="file"],
.ma-contact-form-panel select,
.ma-contact-form-panel textarea,
.ma-inquiry-form--fluent .ff-el-form-control,
.ma-inquiry-form--fluent input[type="text"],
.ma-inquiry-form--fluent input[type="email"],
.ma-inquiry-form--fluent input[type="url"],
.ma-inquiry-form--fluent input[type="tel"],
.ma-inquiry-form--fluent input[type="number"],
.ma-inquiry-form--fluent input[type="file"],
.ma-inquiry-form--fluent select,
.ma-inquiry-form--fluent textarea {
  width: 100% !important;
  max-width: none !important;
  min-height: 2.95rem;
  padding: 0.72rem 0.85rem;
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-white);
  color: var(--ma-color-text);
  font: inherit;
  line-height: 1.35;
  box-sizing: border-box;
}

.ma-contact-form-panel textarea,
.ma-inquiry-form--fluent textarea {
  min-height: 8rem;
  resize: vertical;
}

.ma-contact-form-panel .ff-el-form-control:focus,
.ma-contact-form-panel input:focus,
.ma-contact-form-panel select:focus,
.ma-contact-form-panel textarea:focus,
.ma-inquiry-form--fluent .ff-el-form-control:focus,
.ma-inquiry-form--fluent input:focus,
.ma-inquiry-form--fluent select:focus,
.ma-inquiry-form--fluent textarea:focus {
  border-color: var(--ma-color-accent);
  box-shadow: 0 0 0 3px rgba(196, 96, 47, 0.16);
  outline: 0;
}

.ma-contact-form-panel .ff-btn-submit,
.ma-contact-form-panel button[type="submit"],
.ma-inquiry-form--fluent .ff-btn-submit,
.ma-inquiry-form--fluent button[type="submit"] {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 3.2rem;
  padding: 0.8rem 1.2rem;
  border: 1px solid var(--ma-color-accent);
  border-radius: var(--ma-radius);
  background: var(--ma-color-accent);
  color: var(--ma-color-white);
  font: inherit;
  font-weight: 800;
  line-height: 1.2;
  cursor: pointer;
  transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
}

.ma-contact-form-panel .ff-btn-submit:hover,
.ma-contact-form-panel .ff-btn-submit:focus,
.ma-contact-form-panel button[type="submit"]:hover,
.ma-contact-form-panel button[type="submit"]:focus,
.ma-inquiry-form--fluent .ff-btn-submit:hover,
.ma-inquiry-form--fluent .ff-btn-submit:focus,
.ma-inquiry-form--fluent button[type="submit"]:hover,
.ma-inquiry-form--fluent button[type="submit"]:focus {
  border-color: var(--ma-color-accent-2);
  background: var(--ma-color-accent-2);
  transform: translateY(-1px);
}

@media (min-width: 48rem) {
  .ma-contact-form-panel .ff-t-container,
  .ma-inquiry-form--fluent .ff-t-container {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .ma-contact-form-panel .ff-el-input--label,
  .ma-inquiry-form--fluent .ff-el-input--label {
    min-height: 2.7rem;
  }

  .ma-contact-form-panel .ff_submit_btn_wrapper,
  .ma-inquiry-form--fluent .ff_submit_btn_wrapper {
    width: 100%;
  }
}

@media (max-width: 47.99rem) {
  .ma-contact-form-panel .ff-t-container,
  .ma-inquiry-form--fluent .ff-t-container {
    grid-template-columns: 1fr;
  }

  .ma-contact-form-panel .ff-el-input--label,
  .ma-inquiry-form--fluent .ff-el-input--label {
    min-height: 0;
  }
}

/* =========================================================
   Contact Page
   ========================================================= */

body.page .site-content.grid-container:has(.ma-contact-page),
body.page .container.grid-container:has(.ma-contact-page) {
  width: 100%;
  max-width: none;
  padding-right: 0;
  padding-left: 0;
}

.ma-contact-page {
  width: 100vw;
  max-width: none;
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
}

.ma-contact-hero {
  padding: var(--ma-space-6) 0 var(--ma-space-5);
  background: var(--ma-color-surface);
}

.ma-contact-hero h1 {
  max-width: 12ch;
  margin: var(--ma-space-2) 0 0;
  font-family: var(--ma-font-head);
  font-size: clamp(2.6rem, 6vw, 4.8rem);
  font-weight: 600;
  line-height: 1;
}

.ma-contact-hero p:not(.ma-section-kicker) {
  max-width: 48rem;
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  font-size: 1.08rem;
  line-height: var(--ma-lh-body);
}

.ma-contact-main {
  padding: var(--ma-section-y) 0;
}

.ma-contact-main__grid {
  display: grid;
  gap: var(--ma-space-5);
  align-items: start;
}

.ma-contact-form-panel,
.ma-contact-card {
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-white);
  box-shadow: 0 14px 34px rgba(43, 39, 36, 0.06);
}

.ma-contact-form-panel {
  padding: var(--ma-space-4);
}

.ma-contact-form {
  display: grid;
  gap: var(--ma-space-5);
  margin-top: var(--ma-space-4);
}

.ma-contact-form fieldset {
  display: grid;
  gap: var(--ma-space-3);
  margin: 0;
  padding: 0;
  border: 0;
}

.ma-contact-form legend {
  margin-bottom: var(--ma-space-2);
  color: var(--ma-color-text);
  font-family: var(--ma-font-head);
  font-size: var(--ma-fs-h3);
  font-weight: 700;
}

.ma-contact-form__grid {
  display: grid;
  gap: var(--ma-space-3);
}

.ma-contact-form .ma-form-row {
  align-content: start;
}

.ma-form-help,
.ma-contact-form__note {
  margin: var(--ma-space-2) 0 0;
  color: var(--ma-color-muted);
  font-size: 0.88rem;
  line-height: 1.5;
}

.ma-contact-form__note {
  margin: 0;
}

.ma-contact-details {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-contact-card {
  padding: var(--ma-space-4);
}

.ma-contact-card h2 {
  margin: var(--ma-space-2) 0 0;
  font-size: clamp(1.4rem, 3vw, 2rem);
  line-height: 1.15;
}

.ma-contact-list {
  display: grid;
  gap: var(--ma-space-3);
  margin: var(--ma-space-4) 0 0;
  padding: 0;
  list-style: none;
}

.ma-contact-list span {
  display: block;
  margin-bottom: var(--ma-space-1);
  color: var(--ma-color-muted);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.ma-contact-list a,
.ma-contact-map-link {
  color: var(--ma-color-text);
  font-weight: 700;
  text-decoration-color: rgba(194, 96, 47, 0.45);
  text-underline-offset: 0.2em;
}

.ma-contact-list a:hover,
.ma-contact-list a:focus,
.ma-contact-map-link:hover,
.ma-contact-map-link:focus {
  color: var(--ma-color-accent);
}

.ma-contact-card address {
  margin: var(--ma-space-3) 0;
  color: var(--ma-color-muted);
  font-style: normal;
  line-height: var(--ma-lh-body);
}

@media (min-width: 48rem) {
  .ma-contact-form__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ma-contact-form .ma-form-row--full,
  .ma-contact-form .ma-button,
  .ma-contact-form__note {
    grid-column: 1 / -1;
  }
}

@media (min-width: 64rem) {
  .ma-contact-main__grid {
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
  }

  .ma-contact-details {
    position: sticky;
    top: 7rem;
  }
}

/* =========================================================
   Services Page
   ========================================================= */

body.page .site-content.grid-container:has(.ma-services-page),
body.page .container.grid-container:has(.ma-services-page) {
  width: 100%;
  max-width: none;
  padding-right: 0;
  padding-left: 0;
}

.ma-services-page {
  width: 100vw;
  max-width: none;
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
}

.ma-services-hero {
  padding: var(--ma-space-6) 0 var(--ma-space-5);
  background: var(--ma-color-surface);
}

.ma-services-hero h1 {
  max-width: 12ch;
  margin: var(--ma-space-2) 0 0;
  font-family: var(--ma-font-head);
  font-size: clamp(2.6rem, 6vw, 4.8rem);
  font-weight: 600;
  line-height: 1;
}

.ma-services-hero p:not(.ma-section-kicker) {
  max-width: 52rem;
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  font-size: 1.08rem;
  line-height: var(--ma-lh-body);
}

.ma-services-capabilities,
.ma-services-process,
.ma-services-cta {
  padding: var(--ma-section-y) 0;
}

.ma-services-capabilities__grid {
  display: grid;
  gap: var(--ma-space-3);
}

.ma-services-capability {
  min-height: 100%;
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-white);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
}

.ma-services-capability p {
  margin: 0;
  color: var(--ma-color-muted);
  font-weight: 700;
  line-height: var(--ma-lh-body);
}

.ma-services-process {
  background: var(--ma-color-surface);
}

.ma-services-process__list {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-services-stage {
  display: grid;
  gap: var(--ma-space-3);
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 14px 34px rgba(43, 39, 36, 0.06);
}

.ma-services-stage__number {
  color: var(--ma-color-accent);
  font-family: var(--ma-font-head);
  font-size: clamp(2.4rem, 6vw, 4.25rem);
  font-weight: 700;
  line-height: 0.9;
}

.ma-services-stage__copy h2 {
  margin: 0;
  font-size: clamp(1.45rem, 3vw, 2rem);
  line-height: 1.15;
}

.ma-services-stage__copy p {
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

.ma-services-cta {
  background: var(--ma-color-text);
  color: var(--ma-color-bg);
}

.ma-services-cta__inner {
  display: grid;
  gap: var(--ma-space-4);
  align-items: center;
}

.ma-services-cta .ma-section-kicker,
.ma-services-cta h2 {
  color: var(--ma-color-bg);
}

.ma-services-cta h2 {
  margin: var(--ma-space-2) 0 0;
  font-size: var(--ma-fs-h2);
  line-height: 1.15;
}

.ma-services-cta p:not(.ma-section-kicker) {
  max-width: 42rem;
  margin: var(--ma-space-3) 0 0;
  color: rgba(250, 248, 245, 0.78);
  line-height: var(--ma-lh-body);
}

.ma-services-cta .ma-button {
  justify-self: start;
}

@media (min-width: 48rem) {
  .ma-services-capabilities__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ma-services-stage {
    grid-template-columns: minmax(5rem, 0.24fr) minmax(0, 1fr);
    align-items: start;
  }
}

@media (min-width: 64rem) {
  .ma-services-capabilities__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .ma-services-process__list {
    gap: var(--ma-space-5);
  }

  .ma-services-stage {
    width: min(100%, 58rem);
  }

  .ma-services-stage:nth-child(even) {
    justify-self: end;
  }

  .ma-services-cta__inner {
    grid-template-columns: minmax(0, 1fr) auto;
  }
}

/* =========================================================
   About Page
   ========================================================= */

body.page .site-content.grid-container:has(.ma-about-page),
body.page .container.grid-container:has(.ma-about-page) {
  width: 100%;
  max-width: none;
  padding-right: 0;
  padding-left: 0;
}

.ma-about-page {
  width: 100vw;
  max-width: none;
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
}

.ma-about-hero {
  padding: var(--ma-space-6) 0 var(--ma-space-5);
  background: var(--ma-color-surface);
}

.ma-about-hero__grid,
.ma-about-serve__grid,
.ma-about-cta__inner {
  display: grid;
  gap: var(--ma-space-5);
  align-items: center;
}

.ma-about-hero h1 {
  max-width: 15ch;
  margin: var(--ma-space-2) 0 0;
  font-family: var(--ma-font-head);
  font-size: clamp(2.35rem, 4.8vw, 4rem);
  font-weight: 600;
  line-height: 1.04;
}

.ma-about-hero p:not(.ma-section-kicker),
.ma-about-serve__copy p,
.ma-about-cta p:not(.ma-section-kicker) {
  color: var(--ma-color-muted);
  font-size: 1.08rem;
  line-height: var(--ma-lh-body);
}

.ma-about-hero p:not(.ma-section-kicker) {
  max-width: 48rem;
  margin: var(--ma-space-3) 0 0;
}

.ma-about-image-slot {
  display: grid;
  align-items: stretch;
  margin: 0;
  overflow: hidden;
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: transparent;
  box-shadow: 0 14px 34px rgba(43, 39, 36, 0.06);
  line-height: 0;
}

.ma-about-image-slot img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
}

.ma-about-image-slot--secondary {
  min-height: 0;
}

.ma-about-story,
.ma-about-difference,
.ma-about-serve,
.ma-about-cta {
  padding: var(--ma-section-y) 0;
}

.ma-about-split {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-about-copy-slot {
  border-left: 3px solid var(--ma-color-accent);
  padding-left: var(--ma-space-4);
}

.ma-about-copy-slot p {
  margin: 0;
  color: var(--ma-color-muted);
  font-size: 1.04rem;
  line-height: var(--ma-lh-body);
}

.ma-about-difference {
  background: var(--ma-color-surface);
}

.ma-about-difference__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-about-difference-card {
  min-height: 100%;
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
}

.ma-about-difference-card h3 {
  margin: 0;
  font-size: var(--ma-fs-h3);
}

.ma-about-difference-card p {
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

.ma-about-serve__copy h2,
.ma-about-cta h2 {
  margin: var(--ma-space-2) 0 0;
  font-size: var(--ma-fs-h2);
  line-height: 1.15;
}

.ma-about-serve__copy p {
  margin: var(--ma-space-3) 0 0;
}

.ma-about-cta {
  background: var(--ma-color-text);
  color: var(--ma-color-bg);
}

.ma-about-cta .ma-section-kicker,
.ma-about-cta h2 {
  color: var(--ma-color-bg);
}

.ma-about-cta p:not(.ma-section-kicker) {
  max-width: 42rem;
  margin: var(--ma-space-3) 0 0;
  color: rgba(250, 248, 245, 0.78);
}

.ma-about-cta .ma-button {
  justify-self: start;
}

@media (min-width: 48rem) {
  .ma-about-split {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
  }

  .ma-about-difference__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 64rem) {
  .ma-about-hero__grid {
    grid-template-columns: minmax(0, 0.85fr) minmax(30rem, 1.15fr);
  }

  .ma-about-serve__grid {
    grid-template-columns: minmax(30rem, 1fr) minmax(0, 0.95fr);
  }

  .ma-about-cta__inner {
    grid-template-columns: minmax(0, 1fr) auto;
  }
}

@media (max-width: 48rem) {
  .ma-about-copy-slot {
    border-left: 0;
    border-top: 3px solid var(--ma-color-accent);
    padding-top: var(--ma-space-3);
    padding-left: 0;
  }
}

/* =========================================================
   Sustainability Page
   ========================================================= */

body.page .site-content.grid-container:has(.ma-sustainability-page),
body.page .container.grid-container:has(.ma-sustainability-page) {
  width: 100%;
  max-width: none;
  padding-right: 0;
  padding-left: 0;
}

.ma-sustainability-page {
  width: 100vw;
  max-width: none;
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
}

.ma-sustainability-hero {
  padding: var(--ma-space-6) 0 var(--ma-space-5);
  background: var(--ma-color-surface);
}

.ma-sustainability-hero h1 {
  max-width: 12ch;
  margin: var(--ma-space-2) 0 0;
  font-family: var(--ma-font-head);
  font-size: clamp(2.6rem, 6vw, 4.8rem);
  font-weight: 600;
  line-height: 1;
}

.ma-sustainability-hero p:not(.ma-section-kicker) {
  max-width: 52rem;
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  font-size: 1.08rem;
  line-height: var(--ma-lh-body);
}

.ma-sustainability-actions,
.ma-sustainability-badges,
.ma-sustainable-fabrics,
.ma-sustainability-cta {
  padding: var(--ma-section-y) 0;
}

.ma-sustainability-actions__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-sustainability-card {
  min-height: 100%;
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-white);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
}

.ma-sustainability-card h3 {
  margin: 0;
  font-size: var(--ma-fs-h3);
}

.ma-sustainability-card p {
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

.ma-sustainability-badges {
  background: var(--ma-color-surface);
}

.ma-sustainability-badges .ma-certification-groups {
  gap: var(--ma-space-4);
}

.ma-sustainability-badges .ma-certification-group {
  gap: var(--ma-space-3);
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.05);
}

.ma-sustainability-badges .ma-certification-group p {
  max-width: 56rem;
  font-size: 0.98rem;
}

.ma-sustainability-badges .ma-home-certifications__strip {
  gap: var(--ma-space-3);
}

.ma-sustainability-badges .ma-certification-badge {
  min-height: 6rem;
  padding: var(--ma-space-2);
  background: rgba(255, 255, 255, 0.76);
}

.ma-sustainability-badges .ma-certification-badge img {
  max-width: 4.8rem;
  max-height: 4.8rem;
}

.ma-sustainable-fabrics {
  background: var(--ma-color-bg);
}

.ma-sustainable-fabrics .ma-section-heading p:not(.ma-section-kicker) {
  max-width: 54rem;
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

.ma-sustainable-fabrics__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-sustainable-fabric-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: var(--ma-color-white);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
}

.ma-sustainable-fabric-card__media {
  display: grid;
  place-items: center;
  width: 100%;
  aspect-ratio: 4 / 3;
  flex: 0 0 auto;
  background:
    linear-gradient(135deg, rgba(194, 96, 47, 0.08), rgba(43, 39, 36, 0.04)),
    var(--ma-color-surface);
}

.ma-sustainable-fabric-card__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.ma-sustainable-fabric-card__body {
  min-width: 0;
  padding: var(--ma-space-4);
  overflow: visible;
}

.ma-sustainable-fabric-card h3 {
  margin: 0;
  font-size: var(--ma-fs-h3);
}

.ma-sustainable-fabric-card p {
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
  overflow-wrap: break-word;
}

.ma-sustainable-fabrics__note {
  max-width: 54rem;
  margin: var(--ma-space-5) 0 0;
  color: var(--ma-color-muted);
  font-size: 0.95rem;
  line-height: var(--ma-lh-body);
}

.ma-sustainability-cta {
  background: var(--ma-color-text);
  color: var(--ma-color-bg);
}

.ma-sustainability-cta__inner {
  display: grid;
  gap: var(--ma-space-4);
  align-items: center;
}

.ma-sustainability-cta .ma-section-kicker,
.ma-sustainability-cta h2 {
  color: var(--ma-color-bg);
}

.ma-sustainability-cta h2 {
  margin: var(--ma-space-2) 0 0;
  font-size: var(--ma-fs-h2);
  line-height: 1.15;
}

.ma-sustainability-cta p:not(.ma-section-kicker) {
  max-width: 44rem;
  margin: var(--ma-space-3) 0 0;
  color: rgba(250, 248, 245, 0.78);
  line-height: var(--ma-lh-body);
}

.ma-sustainability-cta .ma-button {
  justify-self: start;
}

@media (min-width: 48rem) {
  .ma-sustainability-actions__grid,
  .ma-sustainable-fabrics__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 64rem) {
  .ma-sustainability-actions__grid,
  .ma-sustainable-fabrics__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .ma-sustainability-cta__inner {
    grid-template-columns: minmax(0, 1fr) auto;
  }
}

/* =========================================================
   Product Category Pages
   ========================================================= */

body.page .site-content.grid-container:has(.ma-product-category),
body.page .container.grid-container:has(.ma-product-category) {
  width: 100%;
  max-width: none;
  padding-right: 0;
  padding-left: 0;
}

.ma-product-category {
  width: 100vw;
  max-width: none;
  background: var(--ma-color-bg);
  color: var(--ma-color-text);
}

.ma-product-category > section {
  width: 100vw;
  max-width: none;
}

.ma-product-hero {
  background: var(--ma-color-surface);
}

.ma-product-hero__content {
  width: 100%;
  max-width: var(--ma-container);
  margin: 0 auto;
  padding: var(--ma-space-5) var(--ma-space-4) var(--ma-space-6);
}

.ma-product-hero h1 {
  max-width: 13ch;
  margin: var(--ma-space-2) 0 0;
  font-family: var(--ma-font-head);
  font-size: clamp(2.5rem, 6vw, 4.8rem);
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1;
}

.ma-product-hero p:not(.ma-section-kicker) {
  max-width: 42rem;
  margin: var(--ma-space-3) 0 0;
  color: var(--ma-color-muted);
  font-size: 1.08rem;
  line-height: var(--ma-lh-body);
}

.ma-product-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ma-space-3);
  margin-top: var(--ma-space-4);
}

.ma-product-section {
  padding: var(--ma-section-y) 0;
}

.ma-product-intro__grid,
.ma-product-related__layout {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-product-copy-slot {
  border-left: 3px solid var(--ma-color-accent);
  padding-left: var(--ma-space-4);
}

.ma-product-copy-slot p {
  margin: 0;
  color: var(--ma-color-muted);
  font-size: 1.04rem;
  line-height: var(--ma-lh-body);
}

.ma-product-list {
  display: grid;
  gap: var(--ma-space-2);
  margin: 0;
  padding-left: 1.1rem;
  color: var(--ma-color-muted);
  font-size: 1.04rem;
  line-height: var(--ma-lh-body);
}

.ma-product-capabilities {
  background: var(--ma-color-surface);
}

.ma-product-feature {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-product-capabilities__grid,
.ma-product-examples__grid,
.ma-product-specs__grid {
  display: grid;
  gap: var(--ma-space-4);
}

.ma-product-capability-card,
.ma-product-specs article {
  min-height: 100%;
  padding: var(--ma-space-4);
  border: 1px solid var(--ma-color-border);
  border-radius: var(--ma-radius);
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
}

.ma-product-capability-card > span {
  display: block;
  width: 2.2rem;
  height: 0.22rem;
  margin-bottom: var(--ma-space-3);
  border-radius: 999px;
  background: var(--ma-color-accent);
}

.ma-product-capability-card h3,
.ma-product-specs strong {
  margin: 0;
  color: var(--ma-color-text);
  font-size: var(--ma-fs-h3);
}

.ma-product-capability-card p,
.ma-product-specs p {
  margin: var(--ma-space-2) 0 0;
  color: var(--ma-color-muted);
  line-height: var(--ma-lh-body);
}

.ma-product-example-card {
  margin: 0;
  overflow: hidden;
  border-radius: var(--ma-radius);
  background: var(--ma-color-white);
  box-shadow: 0 10px 24px rgba(43, 39, 36, 0.06);
}

.ma-product-example-card img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
}

.ma-product-example-card--placeholder {
  border: 1px dashed rgba(194, 89, 43, 0.38);
  box-shadow: none;
}

.ma-product-image-placeholder {
  display: grid;
  min-height: 13rem;
  aspect-ratio: 4 / 3;
  place-items: center;
  background: linear-gradient(135deg, rgba(194, 89, 43, 0.08), rgba(43, 39, 36, 0.05));
  color: var(--ma-color-muted);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.ma-product-specs {
  background: var(--ma-color-text);
  color: var(--ma-color-bg);
}

.ma-product-specs article {
  border-color: rgba(250, 248, 245, 0.16);
  background: rgba(250, 248, 245, 0.06);
  box-shadow: inset 0 1px 0 rgba(250, 248, 245, 0.08);
}

.ma-product-specs span {
  display: block;
  margin-bottom: var(--ma-space-2);
  color: rgba(250, 248, 245, 0.74);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  line-height: 1.2;
  text-transform: uppercase;
}

.ma-product-specs strong {
  display: block;
  color: var(--ma-color-bg);
}

.ma-product-specs p {
  color: rgba(250, 248, 245, 0.76);
}

.ma-product-related__links {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ma-space-2);
}

.ma-product-related__links a {
  display: inline-flex;
  align-items: center;
  min-height: 2.75rem;
  padding: 0.65rem 1rem;
  border: 1px solid var(--ma-color-border);
  border-radius: 999px;
  background: var(--ma-color-white);
  color: var(--ma-color-text);
  font-weight: 700;
  text-decoration: none;
  transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
}

.ma-product-related__links a:hover,
.ma-product-related__links a:focus {
  border-color: var(--ma-color-accent);
  color: var(--ma-color-accent);
  transform: translateY(-1px);
}

.ma-product-redirect-note {
  padding: var(--ma-space-3) 0;
  border-top: 1px solid var(--ma-color-border);
  background: var(--ma-color-surface);
}

.ma-product-redirect-note p {
  margin: 0;
  color: var(--ma-color-muted);
  font-size: 0.86rem;
}

@media (min-width: 48rem) {
  .ma-product-hero__content {
    padding-top: var(--ma-space-6);
  }

  .ma-product-intro__grid,
  .ma-product-feature,
  .ma-product-related__layout {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
  }

  .ma-product-capabilities__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .ma-product-examples__grid,
  .ma-product-specs__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 48rem) {
  .ma-product-hero h1 {
    max-width: 11ch;
  }

  .ma-product-hero__actions .ma-button {
    width: 100%;
    justify-content: center;
  }

  .ma-product-copy-slot {
    border-left: 0;
    border-top: 3px solid var(--ma-color-accent);
    padding-top: var(--ma-space-3);
    padding-left: 0;
  }
}

@media (min-width: 48rem) {
  .ma-home-inquiry__layout {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
  }
}

/* --- Site Footer --- */
.site-footer {
  background: var(--ma-color-dark);
  color: rgba(250, 248, 245, 0.86);
}

.ma-site-footer {
  background:
    linear-gradient(180deg, var(--ma-color-dark) 0%, var(--ma-color-dark) 100%);
  color: rgba(250, 248, 245, 0.86);
}

.ma-site-footer__inner,
.ma-site-footer__bottom {
  width: 100%;
  max-width: var(--ma-container);
  margin: 0 auto;
  padding-right: var(--ma-space-4);
  padding-left: var(--ma-space-4);
  box-sizing: border-box;
}

.ma-site-footer__inner {
  display: grid;
  gap: var(--ma-space-5);
  padding-top: var(--ma-space-6);
  padding-bottom: var(--ma-space-5);
}

.ma-site-footer__logo {
  display: inline-flex;
  align-items: center;
  gap: var(--ma-space-3);
  color: var(--ma-color-white);
  text-decoration: none;
}

.ma-site-footer__logo img {
  width: 4.25rem;
  height: 4.25rem;
  object-fit: contain;
  background: var(--ma-color-white);
}

.ma-site-footer__logo span {
  font-size: clamp(1.45rem, 2vw, 2rem);
  font-weight: 800;
  line-height: 1.05;
}

.ma-site-footer__brand p {
  max-width: 20rem;
  margin: var(--ma-space-3) 0 0;
  color: rgba(250, 248, 245, 0.68);
  line-height: var(--ma-lh-body);
}

.ma-site-footer h2 {
  margin: 0 0 var(--ma-space-4);
  color: var(--ma-color-white);
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  line-height: 1.2;
  text-transform: uppercase;
}

.ma-site-footer ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.ma-site-footer__nav li + li,
.ma-site-footer__contact li + li {
  margin-top: 0.75rem;
}

.ma-site-footer a {
  color: rgba(250, 248, 245, 0.78);
  text-decoration: none;
}

.ma-site-footer a:hover,
.ma-site-footer a:focus {
  color: var(--ma-color-white);
}

.ma-site-footer__social {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: var(--ma-space-4);
}

.ma-site-footer__social a {
  display: grid;
  width: 2.25rem;
  height: 2.25rem;
  place-items: center;
  border: 1px solid rgba(250, 248, 245, 0.22);
  border-radius: 999px;
  color: var(--ma-color-white);
  background: rgba(255, 255, 255, 0.06);
}

.ma-site-footer__social a:hover,
.ma-site-footer__social a:focus {
  border-color: var(--ma-color-accent);
  background: var(--ma-color-accent);
}

.ma-site-footer__social svg {
  width: 1.15rem;
  height: 1.15rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.ma-site-footer__social svg path:last-child {
  fill: currentColor;
  stroke: none;
}

.ma-site-footer__contact li {
  color: rgba(250, 248, 245, 0.72);
  line-height: 1.55;
}

.ma-site-footer__quote {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  margin-top: var(--ma-space-4);
  padding: 0.7rem 1.05rem;
  border-radius: 999px;
  background: var(--ma-color-accent);
  color: var(--ma-color-white) !important;
  font-weight: 800;
}

.ma-site-footer__quote:hover,
.ma-site-footer__quote:focus {
  background: var(--ma-color-accent-2);
}

.ma-site-footer__bottom {
  padding-top: var(--ma-space-4);
  padding-bottom: var(--ma-space-4);
  border-top: 1px solid rgba(250, 248, 245, 0.16);
  text-align: center;
}

.ma-site-footer__bottom p {
  margin: 0;
  color: rgba(250, 248, 245, 0.72);
  font-weight: 700;
}

@media (min-width: 48rem) {
  .ma-site-footer__inner {
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    align-items: start;
  }
}
